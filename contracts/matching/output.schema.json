{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matching Output",
  "description": "Prototype 0.1 output contract for matching.",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "const": "matching"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this execution."
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial_success",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 date-time with timezone.",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "description": "Stable candidate identifier, e.g. C001.",
                "pattern": "^C[0-9]{3,}$"
              },
              "job_id": {
                "type": "string",
                "description": "Stable job identifier, e.g. J001.",
                "pattern": "^J[0-9]{3,}$"
              },
              "match_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Overall score based only on job-related criteria; formula and weights must be documented."
              },
              "match_status": {
                "type": "string",
                "enum": [
                  "Good Match",
                  "Partial Match",
                  "Low Match"
                ]
              },
              "matched_skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Canonical skill matched."
                },
                "description": "Required skills present in candidate skills."
              },
              "missing_skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Canonical required skill missing."
                },
                "description": "Required skills not present in candidate skills."
              },
              "experience_comparison": {
                "type": "object",
                "properties": {
                  "candidate_experience_years": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Candidate experience; null if missing."
                  },
                  "minimum_required_years": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maximum_preferred_years": {
                    "type": "number",
                    "minimum": 0
                  },
                  "within_required_range": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [],
                "additionalProperties": false,
                "description": "Experience comparison; missing experience must not be inferred."
              },
              "explanation": {
                "type": "string",
                "description": "Human-readable explanation grounded in skills and experience."
              }
            },
            "required": [
              "candidate_id",
              "job_id",
              "match_score",
              "match_status",
              "matched_skills",
              "missing_skills",
              "experience_comparison",
              "explanation"
            ],
            "additionalProperties": false,
            "description": "One candidate-job evaluation."
          },
          "description": "Candidate-job match results."
        },
        "unscored_pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "description": "Stable candidate identifier, e.g. C001.",
                "pattern": "^C[0-9]{3,}$"
              },
              "job_id": {
                "type": "string",
                "description": "Stable job identifier, e.g. J001.",
                "pattern": "^J[0-9]{3,}$"
              },
              "reason": {
                "type": "string",
                "description": "Why a score could not be produced."
              }
            },
            "required": [
              "candidate_id",
              "job_id",
              "reason"
            ],
            "additionalProperties": false,
            "description": "A pair not scored."
          },
          "description": "Pairs excluded from scoring with reasons."
        }
      },
      "required": [
        "matches",
        "unscored_pairs"
      ],
      "additionalProperties": false,
      "description": "matching module result payload."
    },
    "summary": {
      "type": "object",
      "properties": {
        "evaluated_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "unscored_pair_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "matching processing summary."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable description."
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Related record ID, if applicable."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Related field, if applicable."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "description": "A validation or processing issue."
      },
      "description": "Errors and warnings; empty array when none."
    }
  },
  "required": [
    "module",
    "schema_version",
    "run_id",
    "status",
    "created_at",
    "data",
    "summary",
    "errors"
  ],
  "additionalProperties": false
}
