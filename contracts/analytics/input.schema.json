{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analytics Input",
  "description": "Consumes normalized application data and available outputs from other modules. Each optional source can be omitted when unavailable; analytics must report unavailable inputs rather than fabricate metrics.",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Candidate",
        "description": "Normalized candidate record based on candidates_cleaned.csv. Blank optional CSV values become JSON null.",
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "description": "Stable candidate identifier, e.g. C001.",
            "pattern": "^C[0-9]{3,}$"
          },
          "name": {
            "type": "string",
            "description": "Candidate name; required by the dataset."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional email; duplicate review only, never a matching feature.",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional phone stored as text; duplicate review only, never a matching feature."
          },
          "location": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional location; not used for matching."
          },
          "experience_years": {
            "type": [
              "number",
              "null"
            ],
            "description": "Non-negative experience in years.",
            "minimum": 0
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Lowercase canonical skill name."
            },
            "description": "Canonical skills array. CSV semicolon-separated skills are converted to an array."
          },
          "education": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional education information."
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional candidate source; not used for matching."
          },
          "application_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO date YYYY-MM-DD.",
            "format": "date"
          }
        },
        "required": [
          "candidate_id",
          "name",
          "experience_years",
          "skills"
        ],
        "additionalProperties": false
      },
      "description": "Normalized candidate records."
    },
    "jobs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Job",
        "description": "Normalized job record based on jobs_cleaned.csv.",
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "description": "Stable job identifier, e.g. J001.",
            "pattern": "^J[0-9]{3,}$"
          },
          "role": {
            "type": "string",
            "description": "Job role/title."
          },
          "required_skills": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Lowercase canonical skill name."
            },
            "description": "Required canonical skills."
          },
          "min_experience": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum required experience in years."
          },
          "max_experience": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum experience in years."
          }
        },
        "required": [
          "job_id",
          "role",
          "required_skills",
          "min_experience",
          "max_experience"
        ],
        "additionalProperties": false
      },
      "description": "Normalized job records."
    },
    "applications": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Application",
        "description": "Application stage-history row based on applications_cleaned.csv. Preserve every transition as a separate row.",
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "description": "Stable candidate identifier, e.g. C001.",
            "pattern": "^C[0-9]{3,}$"
          },
          "job_id": {
            "type": "string",
            "description": "Stable job identifier, e.g. J001.",
            "pattern": "^J[0-9]{3,}$"
          },
          "stage": {
            "type": "string",
            "enum": [
              "New",
              "Screened",
              "Shortlisted",
              "Interviewed",
              "Offered",
              "Hired",
              "Rejected"
            ],
            "description": "Agreed application stage."
          },
          "stage_date": {
            "type": "string",
            "description": "ISO date YYYY-MM-DD.",
            "format": "date"
          },
          "recruiter_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional recruiter identifier."
          }
        },
        "required": [
          "candidate_id",
          "job_id",
          "stage",
          "stage_date"
        ],
        "additionalProperties": false
      },
      "description": "Application stage-history records."
    },
    "activity": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Activity",
        "description": "Activity row based on activity_cleaned.csv. Event vocabulary is pending approval.",
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "description": "Stable candidate identifier, e.g. C001.",
            "pattern": "^C[0-9]{3,}$"
          },
          "event_type": {
            "type": "string",
            "description": "Activity event type. Preserve source vocabulary until approved."
          },
          "event_date": {
            "type": "string",
            "description": "ISO date YYYY-MM-DD.",
            "format": "date"
          }
        },
        "required": [
          "candidate_id",
          "event_type",
          "event_date"
        ],
        "additionalProperties": false
      },
      "description": "Activity records; event vocabulary may remain pending approval."
    },
    "matching_output": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional matching module output object; pass null if unavailable."
    },
    "duplicate_detection_output": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional duplicate detection output object; pass null if unavailable."
    },
    "ai_automation_output": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional AI Automation output object; pass null if unavailable."
    }
  },
  "required": [
    "candidates",
    "jobs",
    "applications",
    "activity"
  ],
  "additionalProperties": false
}
