{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analytics Output",
  "description": "Prototype 0.1 output contract for analytics.",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "const": "analytics"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this execution."
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial_success",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 date-time with timezone.",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "description": "ISO 8601 date-time with timezone.",
          "format": "date-time"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_name": {
                "type": "string",
                "description": "Stable metric key."
              },
              "label": {
                "type": "string",
                "description": "Display label."
              },
              "value": {
                "type": [
                  "number",
                  "integer",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Unit such as count, percent or years."
              },
              "description": {
                "type": "string",
                "description": "Definition and calculation meaning."
              },
              "source_modules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Source module or dataset name."
                },
                "description": "Inputs used to calculate metric."
              }
            },
            "required": [
              "metric_name",
              "label",
              "value",
              "description",
              "source_modules"
            ],
            "additionalProperties": false,
            "description": "One aggregate metric."
          },
          "description": "Aggregated metrics."
        },
        "application_stage_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "New",
                  "Screened",
                  "Shortlisted",
                  "Interviewed",
                  "Offered",
                  "Hired",
                  "Rejected"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "stage",
              "count"
            ],
            "additionalProperties": false,
            "description": "Application count for a stage."
          },
          "description": "Counts by application stage, based on stage-history interpretation documented by Analytics."
        },
        "data_quality_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Limitations, unavailable sources or caveats affecting interpretation."
          },
          "description": "Notes needed to interpret the report."
        },
        "source_run_ids": {
          "type": "object",
          "description": "Run IDs of consumed module outputs; keys are module names.",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "required": [
        "generated_at",
        "metrics",
        "application_stage_counts",
        "data_quality_notes",
        "source_run_ids"
      ],
      "additionalProperties": false,
      "description": "analytics module result payload."
    },
    "summary": {
      "type": "object",
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "job_count": {
          "type": "integer",
          "minimum": 0
        },
        "application_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "metric_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "analytics processing summary."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable description."
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Related record ID, if applicable."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Related field, if applicable."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "description": "A validation or processing issue."
      },
      "description": "Errors and warnings; empty array when none."
    }
  },
  "required": [
    "module",
    "schema_version",
    "run_id",
    "status",
    "created_at",
    "data",
    "summary",
    "errors"
  ],
  "additionalProperties": false
}
