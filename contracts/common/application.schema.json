{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application",
  "description": "Application stage-history row based on applications_cleaned.csv. Preserve every transition as a separate row.",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "Stable candidate identifier, e.g. C001.",
      "pattern": "^C[0-9]{3,}$"
    },
    "job_id": {
      "type": "string",
      "description": "Stable job identifier, e.g. J001.",
      "pattern": "^J[0-9]{3,}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "New",
        "Screened",
        "Shortlisted",
        "Interviewed",
        "Offered",
        "Hired",
        "Rejected"
      ],
      "description": "Agreed application stage."
    },
    "stage_date": {
      "type": "string",
      "description": "ISO date YYYY-MM-DD.",
      "format": "date"
    },
    "recruiter_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional recruiter identifier."
    }
  },
  "required": [
    "candidate_id",
    "job_id",
    "stage",
    "stage_date"
  ],
  "additionalProperties": false
}
