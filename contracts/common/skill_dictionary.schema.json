{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Dictionary Entry",
  "description": "Mapping row based on skill_dictionary.csv.",
  "type": "object",
  "properties": {
    "original_skill": {
      "type": "string",
      "description": "Original skill text."
    },
    "canonical_skill": {
      "type": "string",
      "description": "Approved lowercase canonical skill."
    }
  },
  "required": [
    "original_skill",
    "canonical_skill"
  ],
  "additionalProperties": false
}
