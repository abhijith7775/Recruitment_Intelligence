{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw Activity CSV Row",
  "description": "Raw activity CSV row; all cells are text.",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "Candidate ID text."
    },
    "event_type": {
      "type": "string",
      "description": "Event type text; vocabulary pending approval."
    },
    "event_date": {
      "type": "string",
      "description": "Event date text YYYY-MM-DD."
    }
  },
  "required": [
    "candidate_id",
    "event_type",
    "event_date"
  ],
  "additionalProperties": false
}
