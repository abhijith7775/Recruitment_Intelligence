{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Preparation Output",
  "description": "Prototype 0.1 output contract for data_preparation.",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "const": "data_preparation"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this execution."
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial_success",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 date-time with timezone.",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Candidate",
            "description": "Normalized candidate record based on candidates_cleaned.csv. Blank optional CSV values become JSON null.",
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "description": "Stable candidate identifier, e.g. C001.",
                "pattern": "^C[0-9]{3,}$"
              },
              "name": {
                "type": "string",
                "description": "Candidate name; required by the dataset."
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional email; duplicate review only, never a matching feature.",
                "format": "email"
              },
              "phone": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional phone stored as text; duplicate review only, never a matching feature."
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional location; not used for matching."
              },
              "experience_years": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Non-negative experience in years.",
                "minimum": 0
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Lowercase canonical skill name."
                },
                "description": "Canonical skills array. CSV semicolon-separated skills are converted to an array."
              },
              "education": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional education information."
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional candidate source; not used for matching."
              },
              "application_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ISO date YYYY-MM-DD.",
                "format": "date"
              }
            },
            "required": [
              "candidate_id",
              "name",
              "experience_years",
              "skills"
            ],
            "additionalProperties": false
          },
          "description": "Normalized candidates."
        },
        "jobs": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Job",
            "description": "Normalized job record based on jobs_cleaned.csv.",
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string",
                "description": "Stable job identifier, e.g. J001.",
                "pattern": "^J[0-9]{3,}$"
              },
              "role": {
                "type": "string",
                "description": "Job role/title."
              },
              "required_skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Lowercase canonical skill name."
                },
                "description": "Required canonical skills."
              },
              "min_experience": {
                "type": "number",
                "minimum": 0,
                "description": "Minimum required experience in years."
              },
              "max_experience": {
                "type": "number",
                "minimum": 0,
                "description": "Maximum experience in years."
              }
            },
            "required": [
              "job_id",
              "role",
              "required_skills",
              "min_experience",
              "max_experience"
            ],
            "additionalProperties": false
          },
          "description": "Normalized jobs."
        },
        "applications": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Application",
            "description": "Application stage-history row based on applications_cleaned.csv. Preserve every transition as a separate row.",
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "description": "Stable candidate identifier, e.g. C001.",
                "pattern": "^C[0-9]{3,}$"
              },
              "job_id": {
                "type": "string",
                "description": "Stable job identifier, e.g. J001.",
                "pattern": "^J[0-9]{3,}$"
              },
              "stage": {
                "type": "string",
                "enum": [
                  "New",
                  "Screened",
                  "Shortlisted",
                  "Interviewed",
                  "Offered",
                  "Hired",
                  "Rejected"
                ],
                "description": "Agreed application stage."
              },
              "stage_date": {
                "type": "string",
                "description": "ISO date YYYY-MM-DD.",
                "format": "date"
              },
              "recruiter_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional recruiter identifier."
              }
            },
            "required": [
              "candidate_id",
              "job_id",
              "stage",
              "stage_date"
            ],
            "additionalProperties": false
          },
          "description": "Application stage-history rows."
        },
        "activity": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Activity",
            "description": "Activity row based on activity_cleaned.csv. Event vocabulary is pending approval.",
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "description": "Stable candidate identifier, e.g. C001.",
                "pattern": "^C[0-9]{3,}$"
              },
              "event_type": {
                "type": "string",
                "description": "Activity event type. Preserve source vocabulary until approved."
              },
              "event_date": {
                "type": "string",
                "description": "ISO date YYYY-MM-DD.",
                "format": "date"
              }
            },
            "required": [
              "candidate_id",
              "event_type",
              "event_date"
            ],
            "additionalProperties": false
          },
          "description": "Activity rows; event vocabulary remains pending approval."
        },
        "validation_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record_type": {
                "type": "string",
                "description": "Dataset name."
              },
              "record_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Record identifier if available."
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Field name if applicable."
              },
              "issue_code": {
                "type": "string",
                "description": "Machine-readable issue code."
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "raw_value": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Original value when useful."
              }
            },
            "required": [
              "record_type",
              "issue_code",
              "message",
              "severity"
            ],
            "additionalProperties": false,
            "description": "Validation finding."
          },
          "description": "Validation errors and warnings; preserve source records rather than silently discarding them."
        },
        "duplicate_review_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id_1": {
                "type": "string",
                "description": "Stable candidate identifier, e.g. C001.",
                "pattern": "^C[0-9]{3,}$"
              },
              "candidate_id_2": {
                "type": "string",
                "description": "Stable candidate identifier, e.g. C001.",
                "pattern": "^C[0-9]{3,}$"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "same_email",
                  "same_phone",
                  "other"
                ]
              },
              "review_status": {
                "type": "string",
                "enum": [
                  "Pending",
                  "Confirmed",
                  "Not Duplicate"
                ]
              }
            },
            "required": [
              "candidate_id_1",
              "candidate_id_2",
              "reason",
              "review_status"
            ],
            "additionalProperties": false,
            "description": "Potential duplicate pair for human review."
          },
          "description": "Possible duplicate pairs for human review."
        },
        "processing_metadata": {
          "type": "object",
          "properties": {
            "input_record_counts": {
              "type": "object",
              "properties": {
                "candidates": {
                  "type": "integer",
                  "minimum": 0
                },
                "jobs": {
                  "type": "integer",
                  "minimum": 0
                },
                "applications": {
                  "type": "integer",
                  "minimum": 0
                },
                "activity": {
                  "type": "integer",
                  "minimum": 0
                },
                "skill_dictionary": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "candidates",
                "jobs",
                "applications",
                "activity",
                "skill_dictionary"
              ],
              "additionalProperties": false,
              "description": "Input row counts."
            },
            "output_record_counts": {
              "type": "object",
              "properties": {
                "candidates": {
                  "type": "integer",
                  "minimum": 0
                },
                "jobs": {
                  "type": "integer",
                  "minimum": 0
                },
                "applications": {
                  "type": "integer",
                  "minimum": 0
                },
                "activity": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "candidates",
                "jobs",
                "applications",
                "activity"
              ],
              "additionalProperties": false,
              "description": "Normalized output counts."
            },
            "missing_value_counts": {
              "type": "object",
              "description": "Missing-value counts by dataset and field.",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "input_record_counts",
            "output_record_counts",
            "missing_value_counts"
          ],
          "additionalProperties": false,
          "description": "Processing counts and missing-value summary."
        }
      },
      "required": [
        "candidates",
        "jobs",
        "applications",
        "activity",
        "validation_issues",
        "duplicate_review_candidates",
        "processing_metadata"
      ],
      "additionalProperties": false,
      "description": "data_preparation module result payload."
    },
    "summary": {
      "type": "object",
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "job_count": {
          "type": "integer",
          "minimum": 0
        },
        "application_count": {
          "type": "integer",
          "minimum": 0
        },
        "activity_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "possible_duplicate_pair_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "data_preparation processing summary."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable description."
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Related record ID, if applicable."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Related field, if applicable."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "description": "A validation or processing issue."
      },
      "description": "Errors and warnings; empty array when none."
    }
  },
  "required": [
    "module",
    "schema_version",
    "run_id",
    "status",
    "created_at",
    "data",
    "summary",
    "errors"
  ],
  "additionalProperties": false
}
